import { useRouter, usePathname } from 'expo-router';
import { useContext, useState, type ReactNode } from 'react';
import * as Location from 'expo-location';
import { ScrollView, StyleSheet, Text } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { Button } from '../components/Button';
import { colors } from '../theme/colors';
import { dynamicType } from '../theme/dynamic-type';
import { spacing } from '../theme/spacing';
import { typography } from '../theme/typography';
import { EnterVisitorMap } from '../app/_layout';

function Page({ title, children }: { title: string; children: ReactNode }) {
  return (
    <SafeAreaView style={styles.safe}>
      <ScrollView contentContainerStyle={styles.page}>
        <Text style={styles.eyebrow}>Fresh Greens</Text>
        <Text accessibilityRole="header" style={styles.title}>{title}</Text>
        {children}
      </ScrollView>
    </SafeAreaView>
  );
}

export function Welcome() {
  const enter = useContext(EnterVisitorMap);
  const router = useRouter();
  const [pending, setPending] = useState(false);
  const [locationMessage, setLocationMessage] = useState('');
  async function openMap() {
    setPending(true);
    setLocationMessage('');
    try {
      const permission = await Location.requestForegroundPermissionsAsync();
      if (permission.granted) {
        enter();
      } else {
        setLocationMessage(permission.canAskAgain
          ? 'Allow access to the simulator’s location to search for places nearby.'
          : 'Location is off for Fresh Greens. Once location access is enabled in the simulator’s settings, try opening the map again.');
      }
    } catch {
      setLocationMessage('The simulator could not open location services. Try again.');
    } finally {
      setPending(false);
    }
  }
  return (
    <Page title="Try a drive">
      <Text style={styles.body}>Search for a landmark like Brooklyn Museum, compare routes, and start a drive. The app uses the simulator’s location.</Text>
      <Text style={styles.body}>Mapbox receives your searches and route locations. The simulator can keep recent searches, so use public places in this shared demo.</Text>
      {locationMessage ? <Text accessibilityRole="alert" style={styles.body}>{locationMessage}</Text> : null}
      <Button text="Use simulator location and open map" loading={pending} onPress={() => void openMap()} />
      <Button text="Read the installed app’s privacy policy and terms" type="secondary" fill="outline" onPress={() => router.push('/legal')} />
    </Page>
  );
}

const featureNames: Record<string, string> = {
  '/report': 'Community reports',
  '/emergency': 'Emergency calls',
  '/pulled-over': 'Traffic stop recording',
  '/roadside': 'Roadside assistance',
  '/share-location': 'Location sharing',
  '/trusted-contact-setup': 'Trusted contacts',
};

export function DeviceFeature() {
  const router = useRouter();
  const name = featureNames[usePathname()] ?? 'Account features';
  return (
    <Page title={name}>
      <Text style={styles.body}>This feature is available on a personal device in the full Fresh Greens app. You can search for a destination and explore driving routes in this session.</Text>
      <Button text="Go back" onPress={() => router.canGoBack() ? router.back() : router.replace('/home')} />
    </Page>
  );
}

export function Menu() {
  const router = useRouter();
  return (
    <Page title="Visitor menu">
      <Button text="Search for a destination" onPress={() => router.replace('/search')} />
      <Button text="Installed app privacy policy and terms" type="secondary" fill="outline" onPress={() => router.push('/legal')} />
      <Button text="Back to map" type="secondary" fill="outline" onPress={() => router.replace('/home')} />
    </Page>
  );
}

const styles = StyleSheet.create({
  safe: { flex: 1, backgroundColor: colors.surfacePage },
  page: { flexGrow: 1, justifyContent: 'center', gap: spacing.md, padding: spacing.lg },
  eyebrow: { ...dynamicType(typography.caption1Emphasized), color: colors.wiltedgreen },
  title: { ...dynamicType(typography.title1Emphasized), color: colors.black },
  body: { ...dynamicType(typography.bodyRegular), color: colors.labelSecondary },
});
